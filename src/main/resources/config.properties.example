db.url=jdbc:postgresql://localhost:5432/epicenter
db.user=postgres
db.password=your_password_here

queue.capacity=5000
producer.thread.pool.size=2
consumer.thread.pool.size=4
batch.size=500

# total ShopEntry rows to generate and load
shop.entry.target=3000000
# itemCatalogSize = rows in item_types.csv * this coefficient
type.increase.coefficient=1000
max.stock.quantity=500
# share of deliberately invalid generated rows, range [0, 99]
invalid.rate.percent=0
recreate.schema=true
